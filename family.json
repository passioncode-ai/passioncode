{
  "name": "passioncode",
  "owner": "passioncode-ai",
  "displayName": "PassionCode.ai",
  "description": "Every PassionCode.ai agent skill, for Claude Code and every other agent on the machine, updated as one set.",
  "members": [
    {
      "name": "fabric-agent-adapter",
      "repo": "passioncode-ai/fabric-agent-adapter",
      "checkout": "~/DATA/fabric-agent-adapter",
      "ref": "agent/fabric-service-m2",
      "kind": "plugin",
      "path": "plugins/fabric-agent-adapter",
      "legacyPluginIds": ["fabric-agent-adapter@fabric-agent-adapter"]
    },
    {
      "name": "observatory-log",
      "repo": "passioncode-ai/project-observatory-dashboard",
      "checkout": "~/DATA/project-observatory-open-source",
      "ref": "main",
      "kind": "plugin",
      "path": "observatory/engine/skill/plugins/observatory-log",
      "legacyPluginIds": ["observatory-log@observatory-log"]
    },
    {
      "name": "mobile-publisher",
      "repo": "passioncode-ai/mobile-publisher-agent",
      "checkout": "~/DATA/mobile-publisher-agent",
      "ref": "main",
      "kind": "skills",
      "path": "skills",
      "skills": ["mobile-publisher"],
      "version": "0.1.0",
      "description": "Store work for App Store, Google Play and Meta Horizon through the local Mobile Publisher service."
    },
    {
      "name": "asset-foundry",
      "repo": "passioncode-ai/asset-foundry",
      "checkout": "~/DATA/asset-foundry",
      "ref": "main",
      "kind": "skills",
      "path": "skills",
      "skills": ["asset-foundry", "godot-assets", "unity-3d-vr-assets", "asset-media-workflows"],
      "version": "0.2.0",
      "description": "Game assets ordered from the local Asset Foundry service: bodies, textures, rigs, animation, images and sound."
    },
    {
      "name": "passioncode",
      "kind": "self",
      "path": "plugin/passioncode",
      "description": "Keeps the PassionCode.ai set current: a once-a-day check at session start and a background update."
    }
  ]
}
